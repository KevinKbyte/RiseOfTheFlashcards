# Claude Code local state (settings, worktree registry); the spec cache is committed.
.claude/*
!.claude/spec-cache/

# Secrets + signing (D10)
*.keystore
*.jks
**/VoiceSDK/*Config*.asset
**/WitConfig*.asset
.env
.env.*

# Build outputs (D10)
Builds/
*.apk
*.aab

# Node / Vercel
node_modules/
.vercel/

# Unreal Engine 5 (ADR 0001). *.apk and *.keystore stay ignored via the D10 blocks above.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
*.sln
*.VC.db
